# ==============================================================================
# ECOFLUX ENVIRONMENT CONFIGURATION
# Note: None of these keys are mandatory! The application runs completely
# self-contained with built-in high-fidelity datasets, Scikit-learn models,
# and demo authentication.
# ==============================================================================

# Supabase Authentication & Database (Optional)
# If you have a Supabase project, copy your Project URL & Anon Key from:
# Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: LLM API Key for live generative responses in Copilot (Gemini / OpenAI)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
